{
  "name": "placement-readiness-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express + MongoDB API and fuzzy trajectory engine for the Placement Readiness system",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
